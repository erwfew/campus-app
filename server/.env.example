# 效园通后端配置

# JWT 密钥（必填，请修改为你自己的随机字符串）
# 如果未配置，服务将拒绝启动
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# JWT 过期时间
JWT_EXPIRES=7d

# 服务端口
PORT=3000

# CORS 允许来源（生产环境建议改为具体域名，多个用逗号分隔）
# 示例: CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=*

# 高德地图 API Key（路线规划后端代理使用，前端不再持有 Key）
AMAP_KEY=your_amap_key_here
